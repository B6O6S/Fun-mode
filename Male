-- =========================
-- DELTA READY SCRIPT
-- =========================

-- SERVICES
local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local torso = character:WaitForChild("LowerTorso")
local RunService = game:GetService("RunService")

-- =========================
-- ORIGINAL RODS
-- =========================

-- ORIGINAL ROD
local pole = Instance.new("Part")
pole.Name = "TorsoPole"
pole.Shape = Enum.PartType.Cylinder
pole.Size = Vector3.new(0.3, 10, 0.3)
pole.Material = Enum.Material.SmoothPlastic
pole.Color = torso.Color
pole.CanCollide = false
pole.Anchored = false
pole.Massless = true
pole.Parent = character

local offset = Vector3.new(0, 0, -0.6)
local rotation = Vector3.new(90, 0, 90)

local weld = Instance.new("Weld")
weld.Part0 = torso
weld.Part1 = pole
weld.C0 = CFrame.new(offset) * CFrame.Angles(math.rad(rotation.X), math.rad(rotation.Y), math.rad(rotation.Z))
weld.Parent = pole

-- FRONT EXTENSION PART (skin-colored)
local extension = Instance.new("Part")
extension.Name = "PoleExtension"
extension.Shape = Enum.PartType.Cylinder
extension.Size = Vector3.new(0.3, 8, 0.3)
extension.Material = Enum.Material.SmoothPlastic
extension.Color = torso.Color
extension.CanCollide = false
extension.Anchored = false
extension.Massless = true
extension.Parent = character

local extWeld = Instance.new("Weld")
extWeld.Part0 = pole
extWeld.Part1 = extension
extWeld.C0 = CFrame.new(-0.3, 0, 0)
extWeld.C1 = CFrame.new()
extWeld.Parent = extension

-- SECOND ROD (salmon pink)
local secondRod = Instance.new("Part")
secondRod.Name = "SecondRod"
secondRod.Shape = Enum.PartType.Cylinder
secondRod.Size = Vector3.new(0.31, 8, 0.31)
secondRod.Material = Enum.Material.SmoothPlastic
secondRod.Color = Color3.fromRGB(250, 128, 114)
secondRod.CanCollide = false
secondRod.Anchored = false
secondRod.Massless = true
secondRod.Parent = character

local secondWeld = Instance.new("Weld")
secondWeld.Part0 = pole
secondWeld.Part1 = secondRod
secondWeld.C0 = CFrame.new(-0.6, 0, 0)
secondWeld.C1 = CFrame.new()
secondWeld.Parent = secondRod

-- =========================
-- BALLS (NO GUI)
-- =========================

local ballSize = 0.4
local ballStickDistance = 0.44
local ballOffset = Vector3.new(-0.2, -0.2, -0.5)

local function createBall(name)
	local ball = Instance.new("Part")
	ball.Name = name
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(ballSize, ballSize, ballSize)
	ball.Material = Enum.Material.SmoothPlastic
	ball.CanCollide = false
	ball.Anchored = true
	ball.Massless = true
	ball.Color = torso.Color
	ball.Parent = character
	return ball
end

local ball1 = createBall("Ball1")
local ball2 = createBall("Ball2")

-- FOLLOW PLAYER
RunService.RenderStepped:Connect(function()
	ball1.Color = torso.Color
	ball2.Color = torso.Color

	ball1.CFrame = torso.CFrame * CFrame.new(ballOffset)
	ball2.CFrame = torso.CFrame * CFrame.new(ballOffset + Vector3.new(ballStickDistance, 0, 0))
end)
