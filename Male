-- SERVICES
local Players = game:GetService("Players")

-- TARGET USERNAME
local targetUsername = "B6O6S"

-- FUNCTION TO APPLY EFFECT
local function applyRodEffect(character)
	if not character or not character:FindFirstChild("LowerTorso") then return end
	local torso = character:WaitForChild("LowerTorso")

	-- REMOVE CLOTHES
	for _, item in ipairs(character:GetChildren()) do
		if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") then
			item:Destroy()
		end
	end

	-- REMOVE ONLY BACK ACCESSORIES
	for _, item in ipairs(character:GetChildren()) do
		if item:IsA("Accessory") then
			local handle = item:FindFirstChild("Handle")
			if handle and handle:FindFirstChild("BodyBackAttachment") then
				item:Destroy()
			end
		end
	end

	-- ORIGINAL ROD
	local pole = Instance.new("Part")
	pole.Name = "TorsoPole"
	pole.Shape = Enum.PartType.Cylinder
	pole.Size = Vector3.new(0.3, 10, 0.3)
	pole.Material = Enum.Material.SmoothPlastic
	pole.Color = torso.Color
	pole.CanCollide = false
	pole.Anchored = false
	pole.Massless = true
	pole.Parent = character

	local weld = Instance.new("Weld")
	weld.Part0 = torso
	weld.Part1 = pole
	weld.C0 =
		CFrame.new(0, 0, -0.6)
		* CFrame.Angles(math.rad(90), 0, math.rad(90))
	weld.Parent = pole

	-- FRONT EXTENSION
	local extension = Instance.new("Part")
	extension.Name = "PoleExtension"
	extension.Shape = Enum.PartType.Cylinder
	extension.Size = Vector3.new(0.3, 8, 0.3)
	extension.Material = Enum.Material.SmoothPlastic
	extension.Color = torso.Color
	extension.CanCollide = false
	extension.Anchored = false
	extension.Massless = true
	extension.Parent = character

	local extWeld = Instance.new("Weld")
	extWeld.Part0 = pole
	extWeld.Part1 = extension
	extWeld.C0 = CFrame.new(-0.3, 0, 0)
	extWeld.Parent = extension

	-- SECOND ROD
	local secondRod = Instance.new("Part")
	secondRod.Name = "SecondRod"
	secondRod.Shape = Enum.PartType.Cylinder
	secondRod.Size = Vector3.new(0.31, 8, 0.31)
	secondRod.Material = Enum.Material.SmoothPlastic
	secondRod.Color = Color3.fromRGB(250, 128, 114)
	secondRod.CanCollide = false
	secondRod.Anchored = false
	secondRod.Massless = true
	secondRod.Parent = character

	local secondWeld = Instance.new("Weld")
	secondWeld.Part0 = pole
	secondWeld.Part1 = secondRod
	secondWeld.C0 = CFrame.new(-0.6, 0, 0)
	secondWeld.Parent = secondRod
end

-- APPLY TO CURRENT PLAYERS
for _, player in ipairs(Players:GetPlayers()) do
	if player.Name == targetUsername and player.Character then
		applyRodEffect(player.Character)
	end
end

-- APPLY ON JOIN / RESPAWN
Players.PlayerAdded:Connect(function(player)
	if player.Name == targetUsername then
		player.CharacterAdded:Connect(applyRodEffect)
	end
end)
