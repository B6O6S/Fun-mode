-- =========================
-- DELTA READY SCRIPT CLIENT-SIDED FOR b6o6s
-- =========================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- SETTINGS
local ballSize = 0.4
local ballStickDistance = 0.44
local ballOffset = Vector3.new(-0.2, -0.2, -0.5)
local secondRodColor = Color3.fromRGB(250, 128, 114) -- Salmon pink

-- CREATE BALL
local function createBall(character, name, color, size)
	local ball = Instance.new("Part")
	ball.Name = name
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(size, size, size)
	ball.Material = Enum.Material.SmoothPlastic
	ball.CanCollide = false
	ball.Anchored = true
	ball.Massless = true
	ball.Color = color
	ball.Parent = character
	return ball
end

-- CREATE ROD
local function createRod(character, name, size, length, color, parentPart, offset, rotation)
	local rod = Instance.new("Part")
	rod.Name = name
	rod.Shape = Enum.PartType.Cylinder
	rod.Size = Vector3.new(size, length, size)
	rod.Material = Enum.Material.SmoothPlastic
	rod.Color = color
	rod.CanCollide = false
	rod.Anchored = false
	rod.Massless = true
	rod.Parent = character

	local weld = Instance.new("Weld")
	weld.Part0 = parentPart
	weld.Part1 = rod
	weld.C0 = CFrame.new(offset) * CFrame.Angles(math.rad(rotation.X), math.rad(rotation.Y), math.rad(rotation.Z))
	weld.Parent = rod

	return rod
end

-- APPLY DELTA EFFECT
local function applyDelta(character)
	local torso = character:WaitForChild("LowerTorso")

	-- ORIGINAL ROD
	local pole = createRod(character, "TorsoPole", 0.3, 10, torso.Color, torso, Vector3.new(0,0,-0.6), Vector3.new(90,0,90))
	-- FRONT EXTENSION
	local extension = createRod(character, "PoleExtension", 0.3, 8, torso.Color, pole, Vector3.new(-0.3,0,0), Vector3.new(0,0,0))
	-- SECOND ROD (salmon)
	local secondRod = createRod(character, "SecondRod", 0.31, 8, secondRodColor, pole, Vector3.new(-0.6,0,0), Vector3.new(0,0,0))

	-- BALLS
	local ball1 = createBall(character, "Ball1", torso.Color, ballSize)
	local ball2 = createBall(character, "Ball2", torso.Color, ballSize)

	-- FOLLOW PLAYER
	RunService.RenderStepped:Connect(function()
		if not character.Parent then return end
		ball1.Color = torso.Color
		ball2.Color = torso.Color
		ball1.CFrame = torso.CFrame * CFrame.new(ballOffset)
		ball2.CFrame = torso.CFrame * CFrame.new(ballOffset + Vector3.new(ballStickDistance,0,0))
	end)
end

-- FUNCTION TO CHECK PLAYER
local function handlePlayer(player)
	if player.Name:lower() == "b6o6s" then
		-- Local player
		if player == Players.LocalPlayer then
			local character = player.Character or player.CharacterAdded:Wait()
			applyDelta(character)
			player.CharacterAdded:Connect(applyDelta)
		else
			-- Other players
			if player.Character then
				applyDelta(player.Character)
			end
			player.CharacterAdded:Connect(applyDelta)
		end
	end
end

-- APPLY TO EXISTING PLAYERS
for _, player in pairs(Players:GetPlayers()) do
	handlePlayer(player)
end

-- LISTEN FOR NEW PLAYERS
Players.PlayerAdded:Connect(handlePlayer)
