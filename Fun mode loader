Players.PlayerAdded:Connect(setup)

-- Lock Nylas in front of B6O6S with back facing him, 1.7 studs away
RunService.Heartbeat:Connect(function()
    if not following then return end

    local b6o6s = Players:FindFirstChild(COMMAND_OWNER)
    local nylas = Players:FindFirstChild(FOLLOW_TARGET_NAME)

    if not (b6o6s and nylas) then return end
    if not (b6o6s.Character and nylas.Character) then return end
    if not (b6o6s.Character.PrimaryPart and nylas.Character.PrimaryPart) then return end

    local bHRP = b6o6s.Character.PrimaryPart
    local nHRP = nylas.Character.PrimaryPart

    -- Position 1.7 studs in front of B6O6S
    local front = bHRP.CFrame * CFrame.new(0, 0, -1.7)

    -- Make Nylas face the SAME direction as B6O6S (so her back faces him)
    nHRP.CFrame = CFrame.new(front.Position, front.Position + bHRP.CFrame.LookVector)
end)
