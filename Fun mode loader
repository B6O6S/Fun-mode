-- SERVICES
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local PhysicsService = game:GetService("PhysicsService")

-- SCRIPT URLS
local MALE_URL = "https://raw.githubusercontent.com/B6O6S/Fun-mode/refs/heads/main/Male"
local FEMALE_URL = "https://raw.githubusercontent.com/B6O6S/Fun-mode/refs/heads/main/Female"

-- SETTINGS
local COMMAND_OWNER = "B6O6S"
local FOLLOW_TARGET_NAME = "Nylas91"

-- STATES
local following = false
local pos1Active = false
local moveTime = 0

--------------------------------------------------
-- NO PLAYER COLLISION
--------------------------------------------------
pcall(function()
    PhysicsService:CreateCollisionGroup("NoPlayerCollision")
end)
PhysicsService:CollisionGroupSetCollidable("NoPlayerCollision", "NoPlayerCollision", false)

local function setNoCollision(character)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CollisionGroup = "NoPlayerCollision"
        end
    end
end

--------------------------------------------------
-- UTIL
--------------------------------------------------
local function loadScript(player, url)
    local success = pcall(function()
        loadstring(game:HttpGet(url))()
    end)

    if success then
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "Fun Mode",
                Text = "Script loaded successfully!",
                Duration = 3
            })
        end)
    end
end

--------------------------------------------------
-- COMMAND ACTIONS
--------------------------------------------------
local function applyFun()
    local b6o6s = Players:FindFirstChild(COMMAND_OWNER)
    local nylas = Players:FindFirstChild(FOLLOW_TARGET_NAME)
    if not b6o6s then return end

    loadScript(b6o6s, MALE_URL)
    loadScript(b6o6s, FEMALE_URL)

    if nylas then
        loadScript(nylas, FEMALE_URL)
        following = true
    end
end

local function stopFun()
    following = false
    pos1Active = false
end

local function resetAll()
    following = false
    pos1Active = false

    local b6o6s = Players:FindFirstChild(COMMAND_OWNER)
    local nylas = Players:FindFirstChild(FOLLOW_TARGET_NAME)

    if b6o6s then b6o6s:LoadCharacter() end
    if nylas then nylas:LoadCharacter() end
end

--------------------------------------------------
-- CHAT HANDLER (USES ! COMMANDS)
--------------------------------------------------
local function onChat(player, msg)
    msg = msg:lower()
    if player.Name ~= COMMAND_OWNER then return end

    if msg == "!fun" then
        applyFun()
    elseif msg == "!pos1" then
        following = true
        pos1Active = true
    elseif msg == "!unfun" then
        stopFun()
    elseif msg == "!re" then
        resetAll()
    end
end

--------------------------------------------------
-- PLAYER SETUP
--------------------------------------------------
local function setupPlayer(player)
    player.Chatted:Connect(function(msg)
        onChat(player, msg)
    end)

    player.CharacterAdded:Connect(function(char)
        char:WaitForChild("HumanoidRootPart")
        setNoCollision(char)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    setupPlayer(p)
end
Players.PlayerAdded:Connect(setupPlayer)

--------------------------------------------------
-- FOLLOW + POS1 MOVEMENT
--------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
    if not following then return end

    local b6o6s = Players:FindFirstChild(COMMAND_OWNER)
    local nylas = Players:FindFirstChild(FOLLOW_TARGET_NAME)
    if not (b6o6s and nylas) then return end
    if not (b6o6s.Character and nylas.Character) then return end
    if not (b6o6s.Character.PrimaryPart and nylas.Character.PrimaryPart) then return end

    local bHRP = b6o6s.Character.PrimaryPart
    local nHRP = nylas.Character.PrimaryPart

    -- base position (1.7 studs in front)
    local baseCF = bHRP.CFrame * CFrame.new(0, 0, -1.7)

    -- back & forth movement
    local offset = 0
    if pos1Active then
        moveTime += dt
        offset = math.sin(moveTime * 3) * 0.4
    end

    local finalCF = baseCF * CFrame.new(0, 0, offset)

    -- back facing B6O6S
    nHRP.CFrame = CFrame.new(
        finalCF.Position,
        finalCF.Position + bHRP.CFrame.LookVector
    )
end)
