-- Server Script (ServerScriptService)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

-- URLs
local MALE_URL = "https://raw.githubusercontent.com/B6O6S/Fun-mode/refs/heads/main/Male"
local FEMALE_URL = "https://raw.githubusercontent.com/B6O6S/Fun-mode/refs/heads/main/Female"

-- Players that should follow B6O6S
local followers = {}

-- Load remote script + notify
local function loadScript(player, url)
    local success = pcall(function()
        loadstring(game:HttpGet(url))()
    end)

    if success then
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "Fun Mode",
                Text = "Script loaded successfully!",
                Duration = 4
            })
        end)
    else
        warn("Failed to load script for", player.Name)
    end
end

-- Apply !fun
local function applyFun(player)
    if player.Name == "B6O6S" then
        -- B6O6S gets BOTH scripts
        loadScript(player, MALE_URL)
        loadScript(player, FEMALE_URL)
    else
        -- Others get female + follow
        loadScript(player, FEMALE_URL)
        followers[player.UserId] = player
    end
end

-- Stop fun
local function stopFun(player)
    followers[player.UserId] = nil
end

-- Full reset
local function resetPlayer(player)
    stopFun(player)
    player:LoadCharacter()
end

-- Chat handler
local function onChat(player, msg)
    msg = msg:lower()
    if msg == "!fun" then
        applyFun(player)
    elseif msg == "!unfun" then
        stopFun(player)
    elseif msg == "!re" then
        resetPlayer(player)
    end
end

-- Setup player
local function setupPlayer(player)
    player.Chatted:Connect(function(msg)
        onChat(player, msg)
    end)
end

-- Existing & joining players
for _, p in ipairs(Players:GetPlayers()) do
    setupPlayer(p)
end
Players.PlayerAdded:Connect(setupPlayer)

-- Follow loop (ONLY for non-B6O6S players)
RunService.Heartbeat:Connect(function()
    local b6o6s = Players:FindFirstChild("B6O6S")
    if not (b6o6s and b6o6s.Character and b6o6s.Character.PrimaryPart) then return end

    local bHRP = b6o6s.Character.PrimaryPart

    for _, player in pairs(followers) do
        if player.Character and player.Character.PrimaryPart then
            local hrp = player.Character.PrimaryPart
            local offset = bHRP.CFrame * CFrame.new(0, 0, -3)
            hrp.CFrame = CFrame.new(offset.Position, bHRP.Position)
        end
    end
end)
