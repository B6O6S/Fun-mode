-- SERVICES
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local StarterGui = game:GetService("StarterGui")

-- SETTINGS
local COMMAND_OWNER = "B6O6S"
local FOLLOW_TARGET = "Nylas91"

local MALE_URL = "https://raw.githubusercontent.com/B6O6S/Fun-mode/refs/heads/main/Male"
local FEMALE_URL = "https://raw.githubusercontent.com/B6O6S/Fun-mode/refs/heads/main/Female"

local following = false
local originalPositions = {} -- store original positions for /re

-- LOAD SCRIPT + NOTIFICATION
local function loadScript(player, url)
    local success = pcall(function()
        loadstring(game:HttpGet(url))()
    end)
    if success then
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "Fun Mode",
                Text = "Script loaded successfully!",
                Duration = 4
            })
        end)
    else
        warn("Failed to load script for", player.Name)
    end
end

-- APPLY FUN (ONLY B6O6S)
local function applyFun()
    local b6o6s = Players:FindFirstChild(COMMAND_OWNER)
    local nylas = Players:FindFirstChild(FOLLOW_TARGET)
    if not b6o6s then return end

    -- STORE ORIGINAL POSITIONS
    if b6o6s.Character and b6o6s.Character.PrimaryPart then
        originalPositions[COMMAND_OWNER] = b6o6s.Character.PrimaryPart.CFrame
    end
    if nylas and nylas.Character and nylas.Character.PrimaryPart then
        originalPositions[FOLLOW_TARGET] = nylas.Character.PrimaryPart.CFrame
    end

    -- B6O6S gets BOTH scripts
    loadScript(b6o6s, MALE_URL)
    loadScript(b6o6s, FEMALE_URL)

    -- Nylas gets Female + follow
    if nylas then
        loadScript(nylas, FEMALE_URL)
        following = true
    end
end

-- STOP FOLLOW
local function stopFun()
    following = false
end

-- FULL RESET (BOTH PLAYERS)
local function resetAll()
    following = false

    local b6o6s = Players:FindFirstChild(COMMAND_OWNER)
    local nylas = Players:FindFirstChild(FOLLOW_TARGET)

    -- TELEPORT BACK TO ORIGINAL POSITION BEFORE /FUN
    if b6o6s and originalPositions[COMMAND_OWNER] then
        if b6o6s.Character and b6o6s.Character.PrimaryPart then
            b6o6s.Character.PrimaryPart.CFrame = originalPositions[COMMAND_OWNER]
        end
    end

    if nylas and originalPositions[FOLLOW_TARGET] then
        if nylas.Character and nylas.Character.PrimaryPart then
            nylas.Character.PrimaryPart.CFrame = originalPositions[FOLLOW_TARGET]
        end
    end

    -- RESET CHARACTERS
    if b6o6s then b6o6s:LoadCharacter() end
    if nylas then nylas:LoadCharacter() end
end

-- COMMAND HANDLER
local function handleCommand(player, text)
    text = text:lower()
    if player.Name ~= COMMAND_OWNER then return end

    if text == "/fun" then
        applyFun()
    elseif text == "/unfun" then
        stopFun()
    elseif text == "/re" then
        resetAll()
    end
end

-- CHAT SETUP (NEW ROBLOX CHAT)
if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
    TextChatService.OnIncomingMessage = function(message)
        local player = Players:GetPlayerByUserId(message.TextSource.UserId)
        if player then
            handleCommand(player, message.Text)
        end
        return TextChatService.CreateMessage()
    end
else
    -- OLD CHAT FALLBACK
    Players.PlayerAdded:Connect(function(player)
        player.Chatted:Connect(function(msg)
            handleCommand(player, msg)
        end)
    end)
end

-- FOLLOW LOOP (AUTO-RELOCK UNTIL /UNFUN, BACK TOWARD B6O6S, 2 STUDS AWAY)
RunService.Heartbeat:Connect(function()
    if not following then return end

    local b6o6s = Players:FindFirstChild(COMMAND_OWNER)
    local nylas = Players:FindFirstChild(FOLLOW_TARGET)

    if not (b6o6s and nylas) then return end
    if not (b6o6s.Character and nylas.Character) then return end
    if not (b6o6s.Character.PrimaryPart and nylas.Character.PrimaryPart) then return end

    local bHRP = b6o6s.Character.PrimaryPart
    local nHRP = nylas.Character.PrimaryPart

    -- 2 studs in front, facing same direction as B6O6S (back toward him)
    local pos = bHRP.CFrame * CFrame.new(0, 0, -2)
    nHRP.CFrame = CFrame.new(pos.Position, pos.Position + bHRP.CFrame.LookVector)
end)
