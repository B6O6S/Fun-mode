-- SERVICES
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- TARGET USERNAME
local targetUsername = "Nylas91"

-- FUNCTION TO APPLY EFFECT TO A CHARACTER
local function applyBallEffect(character)
    if not character or not character:FindFirstChild("LowerTorso") then return end
    local torso = character:WaitForChild("LowerTorso")

    -- REMOVE CLOTHES (keep head accessories and hair)
    for _, item in pairs(character:GetChildren()) do
        if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") then
            item:Destroy()
        end
    end

    -- BALL SETTINGS
    local ballSize = 0.9
    local initialOffset = Vector3.new(-0.45, 0, 0.5)
    local stickDistance = 0.85 -- slightly overlapping balls

    -- CREATE BALL1
    local ball1 = Instance.new("Part")
    ball1.Name = "Ball1"
    ball1.Shape = Enum.PartType.Ball
    ball1.Size = Vector3.new(ballSize, ballSize, ballSize)
    ball1.Material = Enum.Material.SmoothPlastic
    ball1.CanCollide = false
    ball1.Anchored = true
    ball1.Massless = true
    ball1.Parent = character

    -- CREATE BALL2
    local ball2 = Instance.new("Part")
    ball2.Name = "Ball2"
    ball2.Shape = Enum.PartType.Ball
    ball2.Size = Vector3.new(ballSize, ballSize, ballSize)
    ball2.Material = Enum.Material.SmoothPlastic
    ball2.CanCollide = false
    ball2.Anchored = true
    ball2.Massless = true
    ball2.Parent = character

    -- RENDER LOOP TO FOLLOW PLAYER
    RunService.RenderStepped:Connect(function()
        if torso and ball1 and ball2 then
            ball1.Color = torso.Color
            ball2.Color = torso.Color
            ball1.CFrame = torso.CFrame * CFrame.new(initialOffset)
            ball2.CFrame = torso.CFrame * CFrame.new(initialOffset + Vector3.new(stickDistance, 0, 0))
        end
    end)
end

-- APPLY TO EXISTING PLAYERS
for _, player in pairs(Players:GetPlayers()) do
    if player.Name == targetUsername and player.Character then
        applyBallEffect(player.Character)
    end
end

-- APPLY TO FUTURE PLAYERS AND CHARACTERS
Players.PlayerAdded:Connect(function(player)
    if player.Name == targetUsername then
        player.CharacterAdded:Connect(applyBallEffect)
    end
end)
