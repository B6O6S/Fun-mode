-- DELTA READY 2 BALLS
-- =========================

-- SERVICES
local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local torso = character:WaitForChild("LowerTorso")
local RunService = game:GetService("RunService")

-- ====== BALL SETTINGS ======
local ballSize = 0.7
local initialOffset = Vector3.new(-0.3, 0.8, -0.5)
local stickDistance = 0.69
-- ============================

-- CREATE BALL FUNCTION
local function createBall(name)
	local ball = Instance.new("Part")
	ball.Name = name
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(ballSize, ballSize, ballSize)
	ball.Material = Enum.Material.SmoothPlastic
	ball.CanCollide = false
	ball.Anchored = true
	ball.Massless = true
	ball.Color = torso.Color
	ball.Parent = character
	return ball
end

-- CREATE BALLS
local ball1 = createBall("Ball1")
local ball2 = createBall("Ball2")

-- =========================
-- UPDATE LOOP
-- =========================

RunService.RenderStepped:Connect(function()
	ball1.Color = torso.Color
	ball2.Color = torso.Color

	ball1.CFrame = torso.CFrame * CFrame.new(initialOffset)
	ball2.CFrame = torso.CFrame * CFrame.new(initialOffset + Vector3.new(stickDistance, 0, 0))
end)

