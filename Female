-- =========================
-- DELTA READY 2 BALLS (NO GUI)
-- =========================

-- SERVICES
local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local torso = character:WaitForChild("LowerTorso")
local RunService = game:GetService("RunService")

-- ====== SETTINGS ======
local skinBallSize = 0.7
local salmonBallSize = 0.71

local skinOffset = Vector3.new(0, -0.2, 0)
local salmonOffset = Vector3.new(-0.69, -0.2, 0)

local stickDistance = 0.69
local salmonColor = Color3.fromRGB(250, 128, 114)
-- ======================

-- CREATE BALL FUNCTION
local function createBall(name, color, size, sideFlat)
	local ball = Instance.new("Part")
	ball.Name = name
	ball.Shape = Enum.PartType.Ball
	ball.Material = Enum.Material.SmoothPlastic
	ball.CanCollide = false
	ball.Anchored = true
	ball.Massless = true
	ball.Color = color

	if sideFlat then
		ball.Size = Vector3.new(size * 0.3, size, size) -- Flat from sides
	else
		ball.Size = Vector3.new(size, size, size)
	end

	ball.Parent = character
	return ball
end

-- CREATE BALLS
local skinBall = createBall("SkinBall", torso.Color, skinBallSize, false)
local salmonBall = createBall("SalmonBall", salmonColor, salmonBallSize, true)

-- =========================
-- UPDATE LOOP
-- =========================
RunService.RenderStepped:Connect(function()
	-- Keep colors updated
	skinBall.Color = torso.Color

	-- Follow torso
	skinBall.CFrame = torso.CFrame * CFrame.new(skinOffset)
	salmonBall.CFrame = torso.CFrame * CFrame.new(salmonOffset + Vector3.new(stickDistance, 0, 0))
end)
